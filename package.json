{
  "name": "real-time-social-matching-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Random 1-on-1 text chat inside the Pi Browser, funded by Pi. Backend, frontend and shared contract.",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "yarn workspace @social-matching/shared build",
    "build": "yarn build:shared && yarn workspace @social-matching/backend build",
    "dev": "yarn build:shared && yarn workspace @social-matching/backend dev",
    "prisma:generate": "yarn workspace @social-matching/backend prisma:generate",
    "db:migrate": "yarn workspace @social-matching/backend prisma migrate deploy",
    "demo:match": "yarn workspace @social-matching/backend demo:match",
    "typecheck": "yarn build:shared && yarn workspaces run typecheck",
    "dev:frontend": "yarn build:shared && yarn workspace @social-matching/frontend dev",
    "build:frontend": "yarn build:shared && yarn workspace @social-matching/frontend build"
  },
  "//": "One copy of the Express types. @types/swagger-ui-express otherwise nests @types/express v5 next to our v4, and the two are nominally different types.",
  "resolutions": {
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22"
}
