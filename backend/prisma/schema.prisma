generator client {
  provider = "prisma-client"
  // Build output, gitignored. Outside src/, which is hand-written code.
  output   = "../generated/prisma"
}

// `yarn prisma:generate` also writes a Zod schema for every enum and model below into
// packages/shared/src/generated/prisma.ts. `///` comments become their descriptions.

datasource db {
  provider = "postgresql"
}

/// This app's own role. Never Pi's platform roles.
enum UserRole {
  user
  moderator
  owner
}

/// `suspended` is reversible, `banned` is not. Both block sign-in and every request.
enum UserStatus {
  active
  suspended
  banned
}

/// Self-declared at onboarding.
enum Gender {
  male
  female
  other
}

/// A signed-in Pi account.
model User {
  id       String @id @default(uuid())
  /// Pi account uid, the stable identity. Never the username, which can change.
  piUserId String @unique @map("pi_user_id")
  username String

  /// Self-declared at onboarding, never below Settings.minimumAge. A number rather than a
  /// date of birth because matching filters on an age range.
  age     Int?
  gender  Gender?
  /// ISO 3166-1 alpha-2, uppercase. Checked against the shared country list, not a table.
  country String? @db.Char(2)

  /// Opening line the client pre-fills into the composer when a chat starts. The user still
  /// presses send, so it arrives as an ordinary, reportable message.
  iceBreaker String? @map("ice_breaker")

  role   UserRole   @default(user)
  status UserStatus @default(active)

  /// When a suspension stops applying. Nothing sweeps it: the auth check treats a passed
  /// date as active and clears it. Null on a ban, which never ends.
  suspendedUntil DateTime? @map("suspended_until")

  /// Set the first time age, gender and country are all filled in. Null means the client
  /// routes to onboarding.
  onboardedAt DateTime? @map("onboarded_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete. See the extension in src/config/database.ts.
  deletedAt DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]
  balance       Balance?
  ledgerEntries LedgerEntry[]
  purchases     Purchase[]

  @@map("users")
}

/// One signed-in device. The token itself is never stored, only its SHA-256, so a leaked
/// database cannot be replayed as sessions.
model RefreshToken {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  /// Set on sign-out and on rotation. A revoked token presented again is a stolen copy
  /// being replayed, and revokes every token the user has.
  revokedAt    DateTime? @map("revoked_at")
  /// The token this one was rotated into. Null if it was revoked by sign-out.
  replacedById String?   @map("replaced_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// App-wide policy an admin can change without a deploy. Exactly one row, id 1, created
/// with these defaults the first time it is read.
model Settings {
  id Int @id @default(1)

  /// Onboarding refuses anyone younger.
  minimumAge Int @default(18) @map("minimum_age")

  /// One-time grant after onboarding.
  welcomeRolls  Int   @default(3) @map("welcome_rolls")
  /// Rolls per streak day, day 1 first. Its length is the cycle; after the last day it restarts.
  streakRewards Int[] @default([1, 1, 1, 1, 1, 1, 3]) @map("streak_rewards")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// What a ledger entry records. More types arrive with matchmaking and filters.
enum LedgerEntryType {
  /// The one-time grant after onboarding.
  welcome
  /// Free Rolls outside a purchase, like a daily streak claim.
  bonus
  /// Rolls bought with Pi. `ref` is the Pi payment id.
  purchase
}

/// A user's Rolls. Only ledger.service writes here, always with a ledger entry.
model Balance {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Spendable now.
  available Int @default(0)
  /// Reserved by an in-flight roll: not spendable, not yet spent.
  held      Int @default(0)

  // The default lets the ledger create the row with a raw INSERT.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("balances")
}

/// Append-only record of every Roll movement. available + held always equals the sum of amount.
model LedgerEntry {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   LedgerEntryType
  /// Signed: positive credits, negative debits.
  amount Int
  /// Free-text context, like `onboarding` or `streak:day:3`.
  ref    String?

  /// Unique, so a retried request can never apply the same movement twice.
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

/// A Roll bundle for sale. Never deleted once sold; set `active` to false instead.
model RollPack {
  /// Stable slug the client sends as `metadata.packId`, like `starter`.
  id        String  @id
  rolls     Int
  /// Decimal, not Float: this is money. Pi has 7 decimal places.
  priceInPi Decimal @map("price_in_pi") @db.Decimal(20, 7)
  /// Label shown on the pack, like `popular`.
  tag       String?
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  purchases Purchase[]

  @@map("roll_packs")
}

enum PurchaseStatus {
  pending
  completed
  cancelled
}

/// One Pi payment for a pack. Recorded at approval, credited at completion.
model Purchase {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  piPaymentId String  @unique @map("pi_payment_id")
  /// On-chain transaction id. Null until completed.
  txid        String? @unique

  packId String   @map("pack_id")
  pack   RollPack @relation(fields: [packId], references: [id], onDelete: Restrict)

  /// Copied from the pack at approval, so a later price change never alters this purchase.
  piAmount Decimal @map("pi_amount") @db.Decimal(20, 7)
  rolls    Int

  status PurchaseStatus @default(pending)

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, createdAt])
  @@map("purchases")
}
