generator client {
  provider = "prisma-client"
  // Build output, gitignored. Outside src/, which is hand-written code.
  output   = "../generated/prisma"
}

// `yarn prisma:generate` also writes a Zod schema for every enum and model below into
// packages/shared/src/generated/prisma.ts. `///` comments become their descriptions.

datasource db {
  provider = "postgresql"
}

/// This app's own role. Never Pi's platform roles.
enum UserRole {
  user
  moderator
  owner
}

/// `suspended` is reversible, `banned` is not. Both block sign-in and every request.
enum UserStatus {
  active
  suspended
  banned
}

/// Self-declared at onboarding.
enum Gender {
  male
  female
  other
}

/// A signed-in Pi account.
model User {
  id       String @id @default(uuid())
  /// Pi account uid, the stable identity. Never the username, which can change.
  piUserId String @unique @map("pi_user_id")
  username String

  /// Self-declared at onboarding, never below Settings.minimumAge. A number rather than a
  /// date of birth because matching filters on an age range.
  age     Int?
  gender  Gender?
  /// ISO 3166-1 alpha-2, uppercase. Checked against the shared country list, not a table.
  country String? @db.Char(2)

  /// Opening line the client pre-fills into the composer when a chat starts. The user still
  /// presses send, so it arrives as an ordinary, reportable message.
  iceBreaker String? @map("ice_breaker")

  role   UserRole   @default(user)
  status UserStatus @default(active)

  /// When a suspension stops applying. Nothing sweeps it: the auth check treats a passed
  /// date as active and clears it. Null on a ban, which never ends.
  suspendedUntil DateTime? @map("suspended_until")

  /// Set the first time age, gender and country are all filled in. Null means the client
  /// routes to onboarding.
  onboardedAt DateTime? @map("onboarded_at")

  /// Set when a moderator warns this account, cleared when the user dismisses it. The
  /// report that caused it is the record; this only says "still needs to be shown".
  warnedAt DateTime? @map("warned_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// Soft delete. See the extension in src/config/database.ts.
  deletedAt DateTime? @map("deleted_at")

  refreshTokens RefreshToken[]
  balance       Balance?
  ledgerEntries LedgerEntry[]
  purchases     Purchase[]
  matchFilter   MatchFilter?
  matchTickets  MatchTicket[]
  sessionsAsA   ChatSession[] @relation("SessionUserA")
  sessionsAsB   ChatSession[] @relation("SessionUserB")

  // Back-relations: Prisma requires both sides of a relation. None of these are columns.
  reportsFiled    Report[] @relation("ReportReporter")
  reportsAgainst  Report[] @relation("ReportReported")
  reportsReviewed Report[] @relation("ReportReviewer")
  blocksMade      Block[]  @relation("BlockBlocker")
  blocksAgainst   Block[]  @relation("BlockBlocked")
  legalPublished  LegalDocument[]
  legalAccepted   LegalAcceptance[]

  @@map("users")
}

/// Terms are accepted per revision; the privacy policy is only shown.
enum LegalDocumentType {
  terms
  privacy
}

/// One published revision. Never edited: a change is a new revision, so the exact wording a
/// user accepted can always be read back.
model LegalDocument {
  id   String            @id @default(uuid())
  type LegalDocumentType
  /// Previous + 1, assigned by the server. Shown as "v3".
  revision Int

  title   String
  /// Markdown.
  content String @db.Text

  /// Terms only: asks everyone to accept again. A wording fix leaves it false.
  requiresReaccept Boolean @default(false) @map("requires_reaccept")

  publishedById String?  @map("published_by_id")
  publishedBy   User?    @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime @default(now()) @map("published_at")

  acceptances LegalAcceptance[]

  /// Two publishes racing for the same number: one wins, the other gets a 409.
  @@unique([type, revision])
  @@map("legal_documents")
}

/// Evidence that a user accepted one exact revision. Append-only.
model LegalAcceptance {
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String        @map("document_id")
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  acceptedAt DateTime @default(now()) @map("accepted_at")

  @@id([userId, documentId])
  @@map("legal_acceptances")
}

enum ReportReason {
  harassment
  sexual_content
  scam_or_spam
  underage
  other
}

enum ReportStatus {
  pending
  actioned
  dismissed
}

/// What a moderator did. `dismiss` closes the report without touching the user.
enum ModerationAction {
  warn
  suspend
  ban
  dismiss
}

/// A user reporting their chat partner. Filing one ends the chat and blocks the pair.
model Report {
  id        String      @id @default(uuid())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  reporterId     String @map("reporter_id")
  reporter       User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String @map("reported_user_id")
  reportedUser   User   @relation("ReportReported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  reason ReportReason
  note   String?

  /// The chat's last messages, frozen at report time: the only chat content ever stored.
  /// [{ senderId, body, sentAt }]
  messages Json

  status ReportStatus @default(pending)

  /// Set together when a moderator closes it: what they did, who, and why.
  action       ModerationAction?
  reviewedById String?           @map("reviewed_by_id")
  reviewedBy   User?             @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?           @map("review_note")
  reviewedAt   DateTime?         @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// One report per person per chat.
  @@unique([sessionId, reporterId])
  /// The moderator queue, oldest pending first.
  @@index([status, createdAt])
  /// "Has this user been reported before?"
  @@index([reportedUserId, createdAt])
  @@map("reports")
}

/// One user hiding another. Created by reporting. Matching skips a pair blocked either way
/// for Settings.blockHours after `createdAt`.
model Block {
  blockerId String @map("blocker_id")
  blocker   User   @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String @map("blocked_id")
  blocked   User   @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  /// Reset on a repeat report, which restarts the window.
  createdAt DateTime @default(now()) @map("created_at")

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum MatchTicketStatus {
  waiting
  matched
  cancelled
  /// Nobody was found in time. The Rolls were refunded.
  expired
}

/// One roll. The live queue is in memory; this row is the money side (what was held) and what
/// startup uses to refund rolls a crash left waiting.
model MatchTicket {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status   MatchTicketStatus @default(waiting)
  /// Rolls held for this roll: the base cost plus each filter that was on.
  rollCost Int               @map("roll_cost")

  sessionId String?      @map("session_id")
  session   ChatSession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  settledAt DateTime? @map("settled_at")

  @@index([status])
  @@index([userId, createdAt])
  @@map("match_tickets")
}

enum SessionEndReason {
  /// One of them left.
  left
  /// One of them reported the other.
  reported
  /// A moderator suspended or banned one of them.
  moderated
}

/// A 1-on-1 chat between two matched users. Open while `endedAt` is null.
model ChatSession {
  id      String @id @default(uuid())
  userAId String @map("user_a_id")
  userA   User   @relation("SessionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String @map("user_b_id")
  userB   User   @relation("SessionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  /// Who ended it. Null while open.
  endedById   String?           @map("ended_by_id")
  endedReason SessionEndReason? @map("ended_reason")

  tickets MatchTicket[]
  reports Report[]

  @@index([endedAt])
  @@map("chat_sessions")
}

/// Whether a country list means "only these" or "anyone but these".
enum CountryMode {
  include
  exclude
}

/// Who a user wants to match with. Matching is mutual. Created on first use. Values are kept
/// while a filter is off, so turning it back on restores them.
model MatchFilter {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ageEnabled Boolean @default(false) @map("age_enabled")
  minAge     Int     @default(18) @map("min_age")
  maxAge     Int     @default(99) @map("max_age")

  /// On with no gender picked counts as off.
  genderEnabled Boolean @default(false) @map("gender_enabled")
  gender        Gender?

  /// On with an empty active list counts as off.
  countryEnabled   Boolean     @default(false) @map("country_enabled")
  /// Which list applies. Both are kept.
  countryMode      CountryMode @default(include) @map("country_mode")
  /// ISO codes from the shared list. A CHECK in the migration keeps them two uppercase letters.
  includeCountries String[]    @default([]) @map("include_countries")
  excludeCountries String[]    @default([]) @map("exclude_countries")

  /// Bought with Rolls and kept forever. A list may hold Settings' free slots plus these.
  extraIncludeSlots Int @default(0) @map("extra_include_slots")
  extraExcludeSlots Int @default(0) @map("extra_exclude_slots")

  // The default lets the row be created with a raw INSERT.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("match_filters")
}

/// One signed-in device. The token itself is never stored, only its SHA-256, so a leaked
/// database cannot be replayed as sessions.
model RefreshToken {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  /// Set on sign-out and on rotation. A revoked token presented again is a stolen copy
  /// being replayed, and revokes every token the user has.
  revokedAt    DateTime? @map("revoked_at")
  /// The token this one was rotated into. Null if it was revoked by sign-out.
  replacedById String?   @map("replaced_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// App-wide policy an admin can change without a deploy. Exactly one row, id 1, created
/// with these defaults the first time it is read.
model Settings {
  id Int @id @default(1)

  /// Onboarding refuses anyone younger.
  minimumAge Int @default(18) @map("minimum_age")

  /// One-time grant after onboarding.
  welcomeRolls  Int   @default(3) @map("welcome_rolls")
  /// Rolls per streak day, day 1 first. Its length is the cycle; after the last day it restarts.
  streakRewards Int[] @default([1, 1, 1, 1, 1, 1, 3]) @map("streak_rewards")

  /// A roll with every filter off.
  baseRollCost      Int @default(1) @map("base_roll_cost")
  /// Added to a roll while that filter is on.
  ageFilterCost     Int @default(2) @map("age_filter_cost")
  genderFilterCost  Int @default(3) @map("gender_filter_cost")
  countryFilterCost Int @default(2) @map("country_filter_cost")

  /// Country slots: free ones, the price of one more, and how many more can be bought.
  freeIncludeSlots     Int @default(2) @map("free_include_slots")
  freeExcludeSlots     Int @default(1) @map("free_exclude_slots")
  includeSlotPrice     Int @default(8) @map("include_slot_price")
  excludeSlotPrice     Int @default(8) @map("exclude_slot_price")
  maxExtraIncludeSlots Int @default(3) @map("max_extra_include_slots")
  maxExtraExcludeSlots Int @default(1) @map("max_extra_exclude_slots")

  /// How long a roll searches before it expires and refunds.
  matchTimeoutSeconds Int @default(30) @map("match_timeout_seconds")

  /// After a report, the pair cannot be matched again for this long.
  blockHours Int @default(72) @map("block_hours")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// What a ledger entry records. `hold` and `refund` carry 0: they move Rolls between
/// available and held without changing what the user owns.
enum LedgerEntryType {
  /// The one-time grant after onboarding.
  welcome
  /// Free Rolls outside a purchase, like a daily streak claim.
  bonus
  /// Rolls bought with Pi. `ref` is the Pi payment id.
  purchase
  /// Rolls spent on something kept forever, like a country slot.
  unlock
  /// Reserved for a roll while it searches.
  hold
  /// A held roll used up by a match.
  spend
  /// A held roll returned: nobody was found, or the roll was cancelled.
  refund
}

/// A user's Rolls. Only ledger.service writes here, always with a ledger entry.
model Balance {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Spendable now.
  available Int @default(0)
  /// Reserved by an in-flight roll: not spendable, not yet spent.
  held      Int @default(0)

  // The default lets the ledger create the row with a raw INSERT.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("balances")
}

/// Append-only record of every Roll movement. available + held always equals the sum of amount.
model LedgerEntry {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   LedgerEntryType
  /// Signed: positive credits, negative debits.
  amount Int
  /// Free-text context, like `onboarding` or `streak:day:3`.
  ref    String?

  /// Unique, so a retried request can never apply the same movement twice.
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

/// A Roll bundle for sale. Never deleted once sold; set `active` to false instead.
model RollPack {
  /// Stable slug the client sends as `metadata.packId`, like `starter`.
  id        String  @id
  rolls     Int
  /// Decimal, not Float: this is money. Pi has 7 decimal places.
  priceInPi Decimal @map("price_in_pi") @db.Decimal(20, 7)
  /// Label shown on the pack, like `popular`.
  tag       String?
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  purchases Purchase[]

  @@map("roll_packs")
}

enum PurchaseStatus {
  pending
  completed
  cancelled
}

/// One Pi payment for a pack. Recorded at approval, credited at completion.
model Purchase {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  piPaymentId String  @unique @map("pi_payment_id")
  /// On-chain transaction id. Null until completed.
  txid        String? @unique

  packId String   @map("pack_id")
  pack   RollPack @relation(fields: [packId], references: [id], onDelete: Restrict)

  /// Copied from the pack at approval, so a later price change never alters this purchase.
  piAmount Decimal @map("pi_amount") @db.Decimal(20, 7)
  rolls    Int

  status PurchaseStatus @default(pending)

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, createdAt])
  @@map("purchases")
}
