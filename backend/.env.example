NODE_ENV=development
PORT=8000

# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/chat_roulette"

# Pi Platform. API key from the Developer Portal (https://develop.pinet.com).
PI_API_KEY=
PLATFORM_API_URL="https://api.minepi.com"

# Signs access tokens. At least 32 characters; changing it invalidates every access token
# (refresh tokens keep working, so clients recover on their next refresh).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Access tokens are short so a stolen one is worth little; refresh tokens are long so users
# stay signed in.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Allowed browser origins, comma-separated. Each must exactly match the Origin header.
FRONTEND_URL="http://localhost:3000"

# Proxies in front of this process (production only). Cloudflare + load balancer = 2.
# TRUST_PROXY_HOPS=1
