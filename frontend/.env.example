# Copy to .env.local. Read at build time: restart `yarn dev:frontend` after changing.

# The backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pi SDK sandbox mode: true while testing at sandbox.minepi.com, false in the real Pi Browser.
NEXT_PUBLIC_PI_SANDBOX=true

# Shows "Sign in as…" for test users. Needs the backend in development or DEMO_MODE.
NEXT_PUBLIC_DEV_SIGNIN=true
